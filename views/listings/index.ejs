
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust Listings</title>

    <style>
        * {
            box-sizing: border-box;
        }
        a{
            text-decoration: none;
            color:black;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        .navbar {
            background: #222;
            color: white;
            padding: 18px 50px;
            font-size: 24px;
            font-weight: bold;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 40px auto;
        }

        h1 {
            margin-bottom: 30px;
        }

        .listings {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        .card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.12);
            transition: transform 0.2s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .content {
            padding: 18px;
        }

        .content h2 {
            margin: 0 0 10px;
            font-size: 21px;
        }

        .description {
            color: #666;
            line-height: 1.5;
        }

        .location {
            margin-top: 15px;
            font-weight: bold;
        }

        .price {
            margin-top: 12px;
            font-size: 18px;
            font-weight: bold;
        }

        .country {
            color: #777;
            font-size: 14px;
        }
    </style>
</head>

<body>
    

    <%- include("../layouts/header.ejs") %>
   <%- include("../layouts/intro.ejs") %>
    <div class="container">

        
        

        <div class="listings">

            <% x.forEach((listing) => { %>

                <a href="/listing/<%=listing._id%>">          <div class="card">

                    <img src="<%= listing.image.url %>" alt="<%= listing.title %>">

                    <div class="content">

                        <h2>
                            <%= listing.title %>
                        </h2>

                        <p class="description">
                            <%= listing.description %>
                        </p>

                        <div class="location">
                            📍 <%= listing.location %>
                        </div>

                        <div class="country">
                            <%= listing.country %>
                        </div>

                        <div class="price">
                            ₹ <%= listing.price.toLocaleString("en-IN") %>
                        </div>

                    </div>

                </div> </a>

      

            <% }) %>

        </div>

    </div>
    <%-include("../layouts/footer.ejs")%>
                
</body>
</html>
