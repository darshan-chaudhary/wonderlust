<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Wonderlust | Discover Your Next Stay</title>


    <style>

        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;

            font-family: Arial, sans-serif;

            background: #f7f7f7;

            color: #222;
        }


        a {
            text-decoration: none;
            color: inherit;
        }


        /* INTRO TEXT */

        .welcome {
            max-width: 1200px;

            margin: 55px auto 30px;

            padding: 0 25px;
        }


        .welcome-tag {
            color: #ff385c;

            font-size: 13px;

            font-weight: bold;

            letter-spacing: 1px;
        }


        .welcome h1 {
            font-size: 38px;

            margin: 10px 0;

            line-height: 1.2;
        }


        .welcome h1 span {
            color: #ff385c;
        }


        .welcome-text {
            color: #666;

            font-size: 16px;

            line-height: 1.7;

            max-width: 650px;

            margin-bottom: 25px;
        }


        /* INFO */

        .info-bar {
            display: flex;

            align-items: center;

            gap: 12px;

            color: #555;

            font-size: 14px;
        }


        .info-bar strong {
            color: #111;
        }


        /* LISTING SECTION */

        .container {
            width: 90%;

            max-width: 1200px;

            margin: 0 auto 60px;
        }


        .section-header {
            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 25px;
        }


        .section-header h2 {
            margin: 0;

            font-size: 25px;
        }


        .section-header p {
            margin: 0;

            color: #777;

            font-size: 14px;
        }


        /* CARDS */

        .listings {
            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(280px, 1fr));

            gap: 28px;
        }


        .card {
            background: white;

            border-radius: 16px;

            overflow: hidden;

            box-shadow:
                0 3px 12px rgba(0, 0, 0, 0.08);

            transition: 0.25s;

            height: 100%;
        }


        .card:hover {
            transform: translateY(-6px);

            box-shadow:
                0 10px 25px rgba(0, 0, 0, 0.14);
        }


        /* IMAGE */

        .image-wrapper {
            position: relative;
        }


        .card img {
            width: 100%;

            height: 230px;

            object-fit: cover;

            display: block;
        }


        .badge {
            position: absolute;

            top: 15px;

            left: 15px;

            background: white;

            padding: 7px 12px;

            border-radius: 20px;

            font-size: 12px;

            font-weight: bold;
        }


        /* CARD CONTENT */

        .content {
            padding: 19px;
        }


        .content h2 {
            margin: 0 0 8px;

            font-size: 20px;
        }


        .description {
            color: #777;

            line-height: 1.5;

            font-size: 14px;

            display: -webkit-box;
            line-clamp:2;
            -webkit-line-clamp: 2;

            -webkit-box-orient: vertical;

            overflow: hidden;

            margin-bottom: 15px;
        }


        .location {
            font-size: 14px;

            font-weight: 600;

            margin-bottom: 5px;
        }


        .country {
            color: #888;

            font-size: 13px;
        }


        .bottom {
            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-top: 18px;

            padding-top: 15px;

            border-top: 1px solid #eee;
        }


        .price {
            font-size: 18px;

            font-weight: bold;
        }


        .night {
            color: #777;

            font-size: 12px;

            font-weight: normal;
        }


        .view {
            color: #ff385c;

            font-size: 13px;

            font-weight: bold;
        }


        /* EMPTY STATE */

        .empty {
            text-align: center;

            background: white;

            padding: 60px 20px;

            border-radius: 15px;
        }


        .empty h2 {
            margin-bottom: 10px;
        }


        .empty p {
            color: #777;
        }


        /* RESPONSIVE */

        @media (max-width: 600px) {

            .welcome {
                margin-top: 35px;
            }

            .welcome h1 {
                font-size: 30px;
            }

            .section-header {
                align-items: flex-start;

                flex-direction: column;

                gap: 8px;
            }

        }

    </style>

</head>


<body>

    <!-- NAVBAR -->

    <%- include("../layouts/header.ejs") %>

    <%- include("../layouts/success.ejs")%>
    <!-- INTRO -->

    <%- include("../layouts/intro.ejs") %>


    <!-- VISITOR WELCOME -->

    <section class="welcome">

        <span class="welcome-tag">
            ✦ WELCOME TO WONDERLUST
        </span>

        <h1>
            Find a place where
            <span>memories begin.</span>
        </h1>

        <p class="welcome-text">
            Looking for a peaceful getaway, a beautiful home,
            or a place to explore something new?
            Browse our collection of stays and find the perfect
            destination for your next adventure.
        </p>


        <div class="info-bar">

            🏡

            <span>
                <strong><%= x.length %></strong>
                places waiting to be explored
            </span>

        </div>

    </section>


    <!-- LISTINGS -->

    <div class="container">


        <div class="section-header">

            <h2>
                Explore Our Stays
            </h2>

            <p>
                Handpicked places for your next journey
            </p>

        </div>


        <% if (x.length > 0) { %>


            <div class="listings">


                <% x.forEach((listing) => { %>


                    <a href="/listing/<%= listing._id %>">


                        <div class="card">


                            <!-- IMAGE -->

                            <div class="image-wrapper">

                                <img
                                    src="<%= listing.image.url %>"
                                    alt="<%= listing.title %>"
                                >

                                <div class="badge">
                                    ⭐ Guest favourite
                                </div>

                            </div>


                            <!-- CONTENT -->

                            <div class="content">


                                <h2>
                                    <%= listing.title %>
                                </h2>


                                <p class="description">
                                    <%= listing.description %>
                                </p>


                                <div class="location">

                                    📍 <%= listing.location %>

                                </div>


                                <div class="country">

                                    <%= listing.country %>

                                </div>


                                <div class="bottom">


                                    <div class="price">

                                        ₹<%= listing.price.toLocaleString("en-IN") %>

                                        <span class="night">
                                            / night
                                        </span>

                                    </div>


                                    <div class="view">

                                        View stay →

                                    </div>


                                </div>


                            </div>


                        </div>


                    </a>


                <% }) %>


            </div>


        <% } else { %>


            <!-- NO LISTINGS -->

            <div class="empty">

                <h2>
                    No stays available yet
                </h2>

                <p>
                    We're adding beautiful new places soon.
                    Check back later!
                </p>

            </div>


        <% } %>


    </div>


    <!-- FOOTER -->

    <%- include("../layouts/footer.ejs") %>


</body>

</html>