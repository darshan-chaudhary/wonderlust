
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= x.title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        .navbar {
            background: #222;
            color: white;
            padding: 18px 50px;
            font-size: 24px;
            font-weight: bold;
        }

        .container {
            width: 90%;
            max-width: 1000px;
            margin: 50px auto;
        }

        .card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        }

        .card img {
            width: 100%;
            height: 450px;
            object-fit: cover;
        }

        .content {
            padding: 30px;
        }

        h1 {
            margin-top: 0;
            font-size: 32px;
        }

        .description {
            color: #555;
            font-size: 17px;
            line-height: 1.6;
        }

        .location {
            margin-top: 20px;
            font-size: 18px;
            font-weight: bold;
        }

        .country {
            color: #777;
            margin-top: 5px;
        }

        .price {
            margin-top: 20px;
            font-size: 24px;
            font-weight: bold;
        }

        .back {
            display: inline-block;
            margin-top: 25px;
            padding: 10px 18px;
            background: #222;
            color: white;
            text-decoration: none;
            border-radius: 7px;
        }

        .back:hover {
            background: #444;
        }

        .btns{
            display: flex;
            margin-top: 10px;
            
        }

        .del-edit{
            padding:10px;
        
            text-decoration: none;
            background: #000000c3;
            color: white;
            box-shadow: 2px 1px 5px 2px rgba(0, 0, 0, 0.727);
            border-radius: 5px;
            margin-left: 20px;

        }
    </style>
</head>

<body>

    <div class="navbar">
        Wanderlust
    </div>

    <div class="container">

        <div class="card">

            <img src="<%= x.image.url %>" alt="<%= x.title %>">

            <div class="content">

                <h1>
                    <%= x.title %>
                </h1>

                <p class="description">
                    <%= x.description %>
                </p>

                <div class="location">
                    📍 <%= x.location %>
                </div>

                <div class="country">
                    <%= x.country %>
                </div>

                <div class="price">
                    ₹ <%= x.price.toLocaleString("en-IN") %>
                </div>
                

                <a href="/listing" class="back">
                    ← Back to Listings
                </a>


                <div class="btns">
                     <a href="/listing/edit/<%=x._id%>"class="del-edit">EDIT</a>
                
                 <a href="/listing/delete/<%=x._id%>"  class="del-edit">delete</a>
                </div>

               

            

            <div class="p-4">
                <h4>leave review</h4>
                  <form action="/listing/<%=x._id%>/reviews" method="post" novalidate class="needs-validation">
                  
                      <label for="rating" class="form-label">Rate</label>
                  
                      <input 
                          type="range" 
                          min="1" 
                          max="5" 
                          id="rating" 
                          name="rate"
                          
                         >
                  
                      <label for="comment" class="form-label">Comment</label>
                      <textarea
                          placeholder="add your experience"
                          id="comment"
                          name="comment"
                          class="form-control"
                          cols="30"
                          rows="5"
                          required
                      ></textarea>
                  
                       <a href="/listing/<%=x._id%>"><button class="btn btn-primary d-block mx-auto mt-3">
                          Submit
                        </button></a> 
                   </form>
             </div>

             <hr>

             <div class="mt-4">
                     <h5 class="text-center">RATINGS & REVIEWS</h5>
              <hr>

                 <% if (x.reviews.length === 0) { %>

                     <p class="text-center text-muted">No reviews yet.</p>

                <% } else { %>

                        <div class="row g-3">

                             <% x.reviews.forEach(review => { %>

                        <div class="col-12 col-sm-6 col-md-3">

                               <div class="card h-100 p-3 shadow-sm">

                                     <div class="d-flex justify-content-between align-items-center">
                                         <strong>Rating</strong>
                                         <span>⭐ <%= review.rate %>/5</span>
                                      </div>

                                   <hr>

                                   <p class="mb-0">
                                       <%= review.comment %>
                                     </p>
                                     <hr>
                                        
                                      <a href="/listing/<%=x._id%>/delete/<%=review._id%>" class="text-center"><button>delete</button></a>

                                </div>

                               
                        </div>

                                   <% }) %>

                     </div>
  
                             <% } %>
                   </div>
            </div>
                  
        </div>

    </div>

  

</body>
</html>
