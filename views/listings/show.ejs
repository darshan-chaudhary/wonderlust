
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= x.title %></title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        .navbar {
            background: #222;
            color: white;
            padding: 18px 50px;
            font-size: 24px;
            font-weight: bold;
        }

        .container {
            width: 90%;
            max-width: 900px;
            margin: 50px auto;
        }

        .card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        }

        .card img {
            width: 100%;
            height: 450px;
            object-fit: cover;
        }

        .content {
            padding: 30px;
        }

        h1 {
            margin-top: 0;
            font-size: 32px;
        }

        .description {
            color: #555;
            font-size: 17px;
            line-height: 1.6;
        }

        .location {
            margin-top: 20px;
            font-size: 18px;
            font-weight: bold;
        }

        .country {
            color: #777;
            margin-top: 5px;
        }

        .price {
            margin-top: 20px;
            font-size: 24px;
            font-weight: bold;
        }

        .back {
            display: inline-block;
            margin-top: 25px;
            padding: 10px 18px;
            background: #222;
            color: white;
            text-decoration: none;
            border-radius: 7px;
        }

        .back:hover {
            background: #444;
        }
    </style>
</head>

<body>

    <div class="navbar">
        Wanderlust
    </div>

    <div class="container">

        <div class="card">

            <img src="<%= x.image.url %>" alt="<%= x.title %>">

            <div class="content">

                <h1>
                    <%= x.title %>
                </h1>

                <p class="description">
                    <%= x.description %>
                </p>

                <div class="location">
                    📍 <%= x.location %>
                </div>

                <div class="country">
                    <%= x.country %>
                </div>

                <div class="price">
                    ₹ <%= x.price.toLocaleString("en-IN") %>
                </div>

                <a href="/listing" class="back">
                    ← Back to Listings
                </a>

                <a href="/edit/<%=x._id%>">EDIT</a>
                <br>
                 <a href="/delete/<%=x._id%>">delete</a>

            </div>

        </div>

    </div>

  

</body>
</html>
