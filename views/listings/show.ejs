
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= x.title %></title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        /* MAIN CONTAINER */

        .listing-container {
            width: 70%;
            max-width: 900px;
            margin: 50px auto;
        }

        /* MAIN CARD */

        .main-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        }

        .main-card > img {
            width: 100%;
            height: 450px;
            object-fit: cover;
            display: block;
        }

        /* CONTENT */

        .content {
            padding: 30px;
        }

        .content h1 {
            margin-top: 0;
            font-size: 32px;
        }

        .description {
            color: #555;
            font-size: 17px;
            line-height: 1.6;
        }

        .location {
            margin-top: 20px;
            font-size: 18px;
            font-weight: bold;
        }

        .country {
            color: #777;
            margin-top: 5px;
        }

        .price {
            margin-top: 20px;
            font-size: 24px;
            font-weight: bold;
        }

        /* BACK BUTTON */

        .back {
            display: inline-block;
            margin-top: 25px;
            padding: 10px 18px;
            background: #222;
            color: white;
            text-decoration: none;
            border-radius: 7px;
        }

        .back:hover {
            background: #444;
        }

        /* EDIT DELETE */

        .btns {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        .del-edit {
            padding: 10px 15px;
            text-decoration: none;
            background: #000000c3;
            color: white;
            box-shadow: 2px 1px 5px 2px rgba(0, 0, 0, 0.2);
            border-radius: 5px;
        }

        .del-edit:hover {
            background: #000;
        }

        /* REVIEW SECTION */

        .review-section {
            background: white;
            margin-top: 25px;
            padding: 25px;
            border-radius: 15px;
        }

        /* REVIEW CARDS */

        .review-card {
            border: 1px solid #eee;
            border-radius: 10px;
            padding: 15px;
            height: 100%;
        }

        /* RESPONSIVE */

        @media (max-width: 768px) {

            .listing-container {
                width: 95%;
                margin: 30px auto;
            }

            .main-card > img {
                height: 300px;
            }

            .content {
                padding: 20px;
            }

            .content h1 {
                font-size: 26px;
            }

        }

    </style>

</head>


<body>

    <!-- NAVBAR -->

    <%- include("../layouts/header.ejs") %>


    <!-- MAIN LISTING -->

    <div class="listing-container">

        <div class="main-card">

            <!-- IMAGE -->

            <img
                src="<%= x.image.url %>"
                alt="<%= x.title %>"
            >


            <!-- LISTING CONTENT -->

            <div class="content">

                <h1>
                    <%= x.title %>
                </h1>


                <p class="description">
                    <%= x.description %>
                </p>


                <div class="location">
                    📍 <%= x.location %>
                </div>


                <div class="country">
                    <%= x.country %>
                </div>


                <div class="price">
                    ₹ <%= x.price.toLocaleString("en-IN") %>
                </div>


                <!-- BACK -->

                <a
                    href="/listing"
                    class="back"
                >
                    ← Back to Listings
                </a>


                <!-- EDIT DELETE -->

                <div class="btns">

                    <a
                        href="/listing/edit/<%= x._id %>"
                        class="del-edit"
                    >
                        EDIT
                    </a>


                    <a
                        href="/listing/delete/<%= x._id %>"
                        class="del-edit"
                    >
                        DELETE
                    </a>

                </div>

            </div>


            <!-- REVIEW SECTION -->

            <div class="review-section">

                <h4 class="mb-4">
                    Leave Review
                </h4>


                <form
                    action="/listing/<%= x._id %>/reviews"
                    method="POST"
                    novalidate
                    class="needs-validation"
                >

                    <!-- RATING -->

                    <label
                        for="rating"
                        class="form-label"
                    >
                        Rate
                    </label>


                    <input
                        type="range"
                        min="1"
                        max="5"
                        id="rating"
                        name="rate"
                        class="form-range mb-3"
                        required
                    >


                    <!-- COMMENT -->

                    <label
                        for="comment"
                        class="form-label"
                    >
                        Comment
                    </label>


                    <textarea
                        placeholder="Add your experience"
                        id="comment"
                        name="comment"
                        class="form-control"
                        rows="5"
                        required
                    ></textarea>


                    <!-- SUBMIT -->

                    <button
                        type="submit"
                        class="btn btn-primary d-block mx-auto mt-3"
                    >
                        Submit
                    </button>

                </form>

            </div>


            <!-- RATINGS & REVIEWS -->

            <div class="review-section">

                <h5 class="text-center">
                    RATINGS & REVIEWS
                </h5>

                <hr>


                <% if (x.reviews.length === 0) { %>

                    <p class="text-center text-muted">
                        No reviews yet.
                    </p>


                <% } else { %>

                    <div class="row g-3">

                        <% x.reviews.forEach(review => { %>

                            <div class="col-12 col-sm-6 col-md-4">

                                <div class="review-card shadow-sm">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <strong>
                                            Rating
                                        </strong>

                                        <span>
                                            ⭐ <%= review.rate %>/5
                                        </span>

                                    </div>


                                    <hr>


                                    <p class="mb-3">
                                        <%= review.comment %>
                                    </p>


                                    <hr>


                                    <a
                                        href="/listing/<%= x._id %>/delete/<%= review._id %>"
                                        class="btn btn-sm btn-danger"
                                    >
                                        Delete
                                    </a>

                                </div>

                            </div>

                        <% }) %>

                    </div>

                <% } %>

            </div>

        </div>

    </div>


    <!-- FOOTER -->

    <%- include("../layouts/footer.ejs") %>


</body>

</html>
