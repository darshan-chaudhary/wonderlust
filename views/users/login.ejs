
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Login | Wonderlust</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

        body {
            min-height: 100vh;
            margin: 0;
            background: #f5f5f5;
        }

        /* LOGIN CARD */

        .login-card {
            width: 100%;
            max-width: 450px;

            border: none;
            border-radius: 15px;

            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
        }

        /* TITLE */

        .login-title {
            font-weight: 700;
            text-align: center;
        }

        /* INPUT */

        .form-control {
            padding: 12px;
            border-radius: 8px;
        }

        .form-control:focus {
            box-shadow: none;
            border-color: #212529;
        }

        /* LOGIN BUTTON */

        .login-btn {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
        }

        /* SIGNUP TEXT */

        .signup-text {
            text-align: center;
            margin-top: 20px;
            color: #666;
        }

        .signup-text a {
            text-decoration: none;
            font-weight: 600;
            color: #212529;
        }

        .signup-text a:hover {
            text-decoration: underline;
        }

    </style>

</head>


<body>

    <!-- NAVBAR -->

    <%- include("../layouts/header.ejs") %>


    <!-- LOGIN -->
     <% if (exist && exist.length) { %>
    <div class="alert alert-danger">
        <%= exist[0] %>
    </div>
     <% } %>

    <div class="container py-5">

        <div class="card login-card mx-auto">

            <div class="card-body p-4 p-md-5">

                <h2 class="login-title mb-2">
                    Welcome 
                </h2>

                <p class="text-center text-muted mb-4">
                    Login to continue to Wonderlust
                </p>


                <form action="/loginuser" method="POST">

                    <!-- USERNAME -->

                    <div class="mb-3">

                        <label
                            for="username"
                            class="form-label"
                        >
                            Username
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="username"
                            name="username"
                            placeholder="Enter username"
                            required
                        >

                    </div>


                    <!-- PASSWORD -->

                    <div class="mb-3">

                        <label
                            for="password"
                            class="form-label"
                        >
                            Password
                        </label>

                        <input
                            type="password"
                            class="form-control"
                            id="password"
                            name="password"
                            placeholder="Enter password"
                            required
                        >

                    </div>


                    <!-- REMEMBER ME -->

                  


                    <!-- LOGIN BUTTON -->

                    <button
                        type="submit"
                        class="btn btn-dark login-btn"
                    >
                        Login
                    </button>

                </form>


                <!-- SIGNUP -->

                <div class="signup-text">

                    Don't have an account?

                    <a href="/signup">
                        Create Account
                    </a>

                </div>

            </div>

        </div>

    </div>


</body>

</html>
