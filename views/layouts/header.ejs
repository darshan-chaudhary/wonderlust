
<!-- Bootstrap CSS -->
<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

<header>
    <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top py-3">

        <div class="container-fluid px-lg-5">

            <!-- Logo -->
            <a href="/" class="navbar-brand d-flex align-items-center gap-2 fw-bold">
                <span class="logo-box">W</span>
                <span>Wonderlust</span>
            </a>


            <!-- Mobile Toggle -->
            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>


            <!-- Navbar Content -->
            <div class="collapse navbar-collapse" id="mainNavbar">

                <!-- Navigation -->
                <div class="navbar-nav mx-auto gap-lg-4">

                    <a href="/listing" class="nav-link active">
                        Home
                    </a>

                    <a href="/listings" class="nav-link">
                        Explore
                    </a>

                    <a href="/book" class="nav-link">
                        Bookings
                    </a>

                    <a href="/about" class="nav-link">
                        About
                    </a>

                    <a href="/contact" class="nav-link">
                        Contact
                    </a>

                </div>


                <!-- Right Side -->
                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">

                    <a
                        href="/listing/new"
                        class="btn host-btn"
                    >
                        + List your place
                    </a>

                    <a
                        href="/signup"
                        class="btn btn-dark login-btn"
                    >
                        Login
                    </a>

                </div>

            </div>

        </div>

    </nav>
</header>


<style>

    /* Logo */

    .logo-box {
        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #ff385c;
        color: white;

        border-radius: 12px;

        font-size: 20px;
    }


    /* Navigation links */

    .navbar .nav-link {
        color: #444;
        font-size: 15px;
        font-weight: 500;

        position: relative;
    }

    .navbar .nav-link:hover {
        color: #ff385c;
    }

    .navbar .nav-link.active {
        color: #111;
        font-weight: 600;
    }


    /* Active underline */

    .navbar .nav-link.active::after {
        content: "";

        position: absolute;

        left: 0;
        right: 0;
        bottom: 0;

        height: 2px;

        background: #ff385c;
    }


    /* Host button */

    .host-btn {
        color: #222;
        font-size: 14px;
        font-weight: 600;

        padding: 10px 16px;

        border-radius: 25px;
    }

    .host-btn:hover {
        background: #f5f5f5;
    }


    /* Login */

    .login-btn {
        padding: 10px 20px;

        border-radius: 25px;

        font-size: 14px;
        font-weight: 600;
    }

    .login-btn:hover {
        background: #ff385c;
        border-color: #ff385c;
    }


    /* Mobile */

    @media (max-width: 991px) {

        .navbar .nav-link.active::after {
            display: none;
        }

        .navbar-nav {
            margin-top: 15px;
        }

        .navbar .nav-link {
            padding: 8px 0;
        }

    }

</style>


<!-- Bootstrap JS -->
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

