
<% if (success && success.length) { %>

    <div
        class="alert alert-success alert-dismissible fade show col-6 mx-auto"
        id="successAlert"
        role="alert"
    >
        <%= success[0] %>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close"
        ></button>
    </div>

<% } %>


<% if (notfound && notfound.length) { %>

    <div
        class="alert alert-danger alert-dismissible fade show col-6 mx-auto"
        id="errorAlert"
        role="alert"
    >
        <%= notfound[0] %>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close"
        ></button>
    </div>

<% } %>


<% if (exist && exist.length) { %>

    <div
        class="alert alert-danger alert-dismissible fade show col-6 mx-auto"
        role="alert"
    >
        <%= exist[0] %>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close"
        ></button>
    </div>

<% } %>
